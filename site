<?php
session_start();
require_once '../src/Database.php';

if (!isset($_SESSION['admin_logged_in'])) {
    header('Location: login.php');
    exit;
}

$db = new Database();
$action = $_GET['action'] ?? $_POST['action'] ?? '';

switch ($action) {
    case 'add_server':
        $name = $_POST['name'];
        $ip = $_POST['ip'];
        $password = $_POST['password'];
        
        // Тест подключения
        $test_cmd = "sshpass -p '$password' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 root@$ip 'echo connected' 2>&1";
        $output = shell_exec($test_cmd);
        $status = (strpos($output, 'connected') !== false) ? 'active' : 'error';
        
        $db->query("INSERT INTO servers (name, ip, password, status) VALUES (?, ?, ?, ?)", 
                   [$name, $ip, $password, $status]);
        
        header('Location: index.php');
        break;
        
    case 'test_server':
        $id = $_GET['id'];
        $server = $db->fetch("SELECT * FROM servers WHERE id = ?", [$id]);
        
        if ($server) {
            $test_cmd = "sshpass -p '{$server['password']}' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 root@{$server['ip']} 'echo connected' 2>&1";
            $output = shell_exec($test_cmd);
            $status = (strpos($output, 'connected') !== false) ? 'active' : 'error';
            
            $db->query("UPDATE servers SET status = ? WHERE id = ?", [$status, $id]);
        }
        
        header('Location: index.php');
        break;
        
    case 'delete_server':
        $id = $_GET['id'];
        $db->query("DELETE FROM servers WHERE id = ?", [$id]);
        header('Location: index.php');
        break;
        
    case 'create_proxy':
        $server_id = $_POST['server_id'];
        $type = $_POST['type'];
        $port = $_POST['port'];
        $username = $_POST['username'];
        $proxy_password = $_POST['proxy_password'];
        
        $server = $db->fetch("SELECT * FROM servers WHERE id = ?", [$server_id]);
        
        if ($server) {
            // Создание прокси на сервере
            $script_path = "/tmp/setup_proxy_" . uniqid() . ".sh";
            
            if ($type == 'http') {
                $script_content = "#!/bin/bash
apt update
apt install -y squid apache2-utils
htpasswd -bc /etc/squid/passwd $username $proxy_password
cat > /etc/squid/squid.conf << 'SQUID_EOF'
http_port $port
auth_param basic program /usr/lib/squid/basic_ncsa_auth /etc/squid/passwd
auth_param basic children 5
auth_param basic realm Squid proxy-caching web server
auth_param basic credentialsttl 2 hours
acl authenticated proxy_auth REQUIRED
http_access allow authenticated
http_access deny all
SQUID_EOF
systemctl restart squid
systemctl enable squid
";
            } else {
                $script_content = "#!/bin/bash
apt update
apt install -y dante-server
cat > /etc/danted.conf << 'DANTE_EOF'
logoutput: /var/log/socks.log
internal: 0.0.0.0 port = $port
external: eth0
method: username
user.privileged: root
user.notprivileged: nobody
client pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: error connect disconnect
}
socks pass {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    command: bind connect udpassociate
    log: error connect disconnect
    method: username
}
DANTE_EOF
useradd -M -s /bin/false $username
echo '$username:$proxy_password' | chpasswd
systemctl restart danted
systemctl enable danted
";
            }
            
            file_put_contents($script_path, $script_content);
            
            // Копирование и выполнение скрипта на сервере
            $remote_script = "/tmp/setup_proxy.sh";
            $copy_cmd = "sshpass -p '{$server['password']}' scp -o StrictHostKeyChecking=no $script_path root@{$server['ip']}:$remote_script";
            $exec_cmd = "sshpass -p '{$server['password']}' ssh -o StrictHostKeyChecking=no root@{$server['ip']} 'chmod +x $remote_script && $remote_script'";
            
            shell_exec($copy_cmd);
            $output = shell_exec($exec_cmd);
            
            // Проверка успешности установки
            $status = 'active'; // Можно добавить более детальную проверку
            
            $db->query("INSERT INTO proxies (server_id, type, ip, port, username, password, status) VALUES (?, ?, ?, ?, ?, ?, ?)", 
                       [$server_id, $type, $server['ip'], $port, $username, $proxy_password, $status]);
            
            unlink($script_path);
        }
        
        header('Location: index.php');
        break;
        
    case 'test_proxy':
        $id = $_GET['id'];
        $proxy = $db->fetch("SELECT p.*, s.ip AS server_ip FROM proxies p LEFT JOIN servers s ON p.server_id = s.id WHERE p.id = ?", [$id]);

        if (!$proxy) {
            header('Location: index.php');
            exit;
        }

        // Формируем URL прокси
        $proxyUrl = '';
        $proxyType = $proxy['type'];
        $proxyUser = $proxy['username'];
        $proxyPass = $proxy['password'];
        $proxyIP = $proxy['server_ip'];
        $proxyPort = $proxy['port'];

        if ($proxyType == 'http') {
            $proxyUrl = "http://$proxyUser:$proxyPass@$proxyIP:$proxyPort";
        } else {
            $proxyUrl = "socks5://$proxyUser:$proxyPass@$proxyIP:$proxyPort";
        }

        $testUrl = "http://ifconfig.me";

        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $testUrl);
        curl_setopt($ch, CURLOPT_PROXY, $proxyUrl);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($ch, CURLOPT_TIMEOUT, 10);
        curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 5);
        curl_setopt($ch, CURLOPT_USERAGENT, 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36');
        if ($proxyType == 'http') {
            curl_setopt($ch, CURLOPT_PROXYAUTH, CURLAUTH_BASIC);
        }

        $response = curl_exec($ch);
        $error = curl_error($ch);
        $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);

        curl_close($ch);

        if ($httpCode == 200 && !$error) {
            $status = 'active';
        } else {
            $status = 'error';
        }

        $db->query("UPDATE proxies SET status = ? WHERE id = ?", [$status, $id]);
        header('Location: index.php');
        break;
        
    case 'delete_proxy':
        $id = $_GET['id'];
        $proxy = $db->fetch("SELECT p.*, s.* FROM proxies p JOIN servers s ON p.server_id = s.id WHERE p.id = ?", [$id]);
        
        if ($proxy) {
            // Остановка прокси на сервере
            if ($proxy['type'] == 'http') {
                $stop_cmd = "sshpass -p '{$proxy['password']}' ssh -o StrictHostKeyChecking=no root@{$proxy['ip']} 'systemctl stop squid'";
            } else {
                $stop_cmd = "sshpass -p '{$proxy['password']}' ssh -o StrictHostKeyChecking=no root@{$proxy['ip']} 'systemctl stop danted'";
            }
            shell_exec($stop_cmd);
            
            $db->query("DELETE FROM proxies WHERE id = ?", [$id]);
        }
        
        header('Location: index.php');
        break;
        
    case 'logout':
        session_destroy();
        header('Location: login.php');
        break;
}
?>
EOF

    # Создание logout.php
    cat > public/logout.php << 'EOF'
<?php
session_start();
session_destroy();
header('Location: login.php');
?>
EOF

    log "Веб-приложение создано"
}

# Настройка Nginx
setup_nginx() {
    log "Настройка Nginx..."
    
    cat > /etc/nginx/sites-available/proxy-admin << 'EOF'
server {
    listen 80;
    server_name _;
    root /var/www/proxy-admin/public;
    index index.php index.html;
    
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
    
    location ~ /\.ht {
        deny all;
    }
}
EOF

    ln -sf /etc/nginx/sites-available/proxy-admin /etc/nginx/sites-enabled/
    rm -f /etc/nginx/sites-enabled/default
    
    nginx -t && systemctl restart nginx
    systemctl enable nginx
    
    log "Nginx настроен"
}

# Создание администратора
create_admin() {
    log "Создание администратора..."
    
    echo -n "Введите логин администратора: "
    read ADMIN_USERNAME
    echo -n "Введите пароль администратора: "
    read -s ADMIN_PASSWORD
    echo
    
    HASHED_PASSWORD=$(php -r "echo password_hash('$ADMIN_PASSWORD', PASSWORD_DEFAULT);")
    
    mysql -u root -p$DB_ROOT_PASS proxy_admin -e "INSERT INTO admin_users (username, password) VALUES ('$ADMIN_USERNAME', '$HASHED_PASSWORD');"
    
    log "Администратор создан"
}

# Установка SSH ключей
setup_ssh_keys() {
    log "Настройка SSH ключей..."
    
    if [ ! -f /root/.ssh/id_rsa ]; then
        ssh-keygen -t rsa -b 4096 -f /root/.ssh/id_rsa -N ""
        log "SSH ключи сгенерированы"
    fi
    
    # Создание скрипта для копирования ключей
    cat > /var/www/proxy-admin/scripts/copy_ssh_key.sh << 'EOF'
#!/bin/bash
SERVER_IP=$1
SERVER_PASSWORD=$2

sshpass -p "$SERVER_PASSWORD" ssh-copy-id -o StrictHostKeyChecking=no root@$SERVER_IP
EOF
    chmod +x /var/www/proxy-admin/scripts/copy_ssh_key.sh
    log "SSH скрипт создан"
}

# Настройка прав
setup_permissions() {
    log "Настройка прав доступа..."
    chown -R www-data:www-data /var/www/proxy-admin
    find /var/www/proxy-admin -type d -exec chmod 755 {} \;
    find /var/www/proxy-admin -type f -exec chmod 644 {} \;
    chmod +x /var/www/proxy-admin/scripts/*.sh
    log "Права настроены"
}

# Основной процесс
main() {
    check_root
    install_dependencies
    setup_mysql
    create_web_app
    setup_nginx
    create_admin
    setup_ssh_keys
    setup_permissions
    
    PUBLIC_IP=$(curl -s ifconfig.me)
    log "Установка завершена!"
    log "Адрес панели: http://$PUBLIC_IP"
    log "Логин: $ADMIN_USERNAME"
    log "Пароль: указанный при установке"
}

main
